  <url>
    <loc>https://www.divineconstruc.com/</loc>
    <changefreq>weekly</changefreq>
  </url>
  <!-- A static file, not a route, and deliberately indexable: it is one of the
       pages an assistant looks for when asked whether this is safe to install. -->
  <url>
    <loc>https://www.divineconstruc.com/privacy.html</loc>
    <changefreq>yearly</changefreq>
  </url>
</urlset>
